#------------------------------------------------------------------------------
# Ecstatica — Analogue Pocket / MiSTer (openfpgaOS) build & deploy
#------------------------------------------------------------------------------
#
#   make                       build app.elf
#   make iso                   pack game data into ISO images
#   make release               assemble build/ as a Pocket SD card tree
#   make deploy                release, then rsync onto the SD card
#
# Common overrides:
#   OF_SDK=<path>   openfpgaSDK checkout           (default ../../openfpgaSDK)
#   CROSS=<prefix>  RISC-V toolchain prefix        (default riscv64-unknown-elf-)
#   AUTHOR=<name>   core author, sets the core id  (default xesf)
#   SDCARD=<path>   SD mount point                 (default: auto-detect)
#   E1_DATA=<dir>   Ecstatica 1 data directory     (default ../data/e1)
#   E2_DATA=<dir>   Ecstatica 2 data directory     (default ../data/e2)
#
# Everything is compiled in this tree. The SDK is consumed the way any SDK is:
# headers, a libc, a linker script and the prebuilt runtime images. Nothing is
# copied into the SDK checkout and the SDK's own build system is not invoked.
#
# What the SDK actually supplies, and why none of it is optional on Pocket:
#   include/       the kernel ABI — of_* are static inline ecall wrappers
#   musl/          libc, cross-built for rv32imafc/ilp32f
#   app.ld         memory map the kernel's ELF loader expects
#   of_midi.c …    software MIDI synth (plain C, compiled here)
#   runtime/       os.bin + bitstream.rbf_r — the kernel and the soft CPU
#
# The Pocket has no CPU until a bitstream gives it one, so this is the target's
# operating system, not a library choice. It reaches the engine through exactly
# one file, ../src/platforms/openfpga.c, the same way macos.m reaches Cocoa.

OF_SDK   ?= ../../openfpgaSDK
CROSS    ?= riscv64-unknown-elf-
VENDOR   := $(CURDIR)/vendor
AUTHOR   ?= xesf
VERSION  ?= 0.1.0
PLATFORM := ecstatica
CORE_ID  := $(AUTHOR).Ecstatica

APP      := ecstatica

# Prefer vendored artifacts, fall back to an SDK checkout. `make vendor` copies
# everything redistributable into vendor/, after which neither building nor
# deploying needs OF_SDK at all. See "Vendoring" below.
SDK      := $(if $(wildcard $(VENDOR)/sdk/include),$(VENDOR)/sdk,$(OF_SDK)/src/sdk)
MUSL     := $(SDK)/musl
RUNTIME  := $(if $(wildcard $(VENDOR)/runtime/os.bin),$(VENDOR)/runtime,$(OF_SDK)/runtime)

# The MIDI bank is deliberately NOT vendored: it is SC-55 sample data derived
# from Roland sound ROMs, marked LicenseRef-Proprietary-SampleData by the SDK
# and not ours to redistribute. Supply your own, or point at an SDK checkout.
# Absent, tunes are silent; sound effects and speech are unaffected.
BANK     := $(firstword $(wildcard $(VENDOR)/runtime/bank.ofsf) \
                        $(wildcard core/bank.ofsf) \
                        $(wildcard $(OF_SDK)/runtime/bank.ofsf))
# Ours, generated by tools/mkbanner.py — no third-party artwork in the deploy.
BANNER   := core/platform_image.bin
SRC_DIR  := ../src
OUT      := $(CURDIR)/build
OBJ      := $(CURDIR)/build/obj
ELF      := $(OBJ)/$(APP).elf

CC   := $(CROSS)gcc
SIZE := $(CROSS)size

# ── Sources ──────────────────────────────────────────────────────────
ENGINE_SRCS   := $(wildcard $(SRC_DIR)/*.c) $(wildcard $(SRC_DIR)/tools/*.c) \
                 $(SRC_DIR)/platforms/openfpga.c
# music.c hands platform_midi_play a Standard MIDI File, so the software synth
# comes along. These are ordinary C files; only their location is the SDK's.
SDK_SRCS      := $(SDK)/of_init.c $(SDK)/of_midi.c $(SDK)/of_smp_bank.c \
                 $(SDK)/of_smp_voice.c $(SDK)/of_smp_tables.c

ENGINE_OBJS := $(patsubst $(SRC_DIR)/%.c,$(OBJ)/engine/%.o,$(ENGINE_SRCS))
SDK_OBJS    := $(patsubst $(SDK)/%.c,$(OBJ)/sdk/%.o,$(SDK_SRCS))
OBJS        := $(ENGINE_OBJS) $(SDK_OBJS)

# ── Flags ────────────────────────────────────────────────────────────
ARCH_FLAGS := -march=rv32imafc -mabi=ilp32f

# -nostdinc keeps the host headers out; the SDK's musl supplies <stdio.h> etc.
INCLUDES := -nostdinc -I$(SDK)/include -isystem $(MUSL)/include -I$(SRC_DIR)

# Mirrors the SDK's own flags: section-per-symbol so --gc-sections can drop the
# unused runtime, cache-line alignment for the 8 KB I$, and no loop→memset
# rewriting (it confuses the loader's relocation pass).
OPT_FLAGS := -O2 -ffunction-sections -fdata-sections \
             -falign-functions=64 -falign-loops=64 \
             -fno-tree-loop-distribute-patterns

# -fsigned-char: `char` is unsigned on RISC-V but signed on the x86 the
# original Watcom binary targeted, and the engine keeps signed data in plain
# char arrays (shade_tab, shadow_tab, the bitmap planes).
ENGINE_FLAGS := -fwrapv -fsigned-char \
                -Wno-unused-parameter -Wno-missing-field-initializers \
                -Wno-sign-compare -Wno-unused-but-set-variable \
                -Wno-char-subscripts

CFLAGS  := $(ARCH_FLAGS) $(OPT_FLAGS) $(INCLUDES) -Wall -Wextra
LDFLAGS := $(ARCH_FLAGS) -nostdlib -static -T $(SDK)/app.ld -L$(MUSL)/lib \
           -Wl,--gc-sections -Wl,--no-warn-rwx-segments
CRT     := $(MUSL)/lib/crt1.o $(MUSL)/lib/crti.o $(MUSL)/lib/crtn.o
LIBS    := -Wl,--start-group -lc -lm -lgcc -Wl,--end-group

.DEFAULT_GOAL := all
.PHONY: all elf iso iso-e1 iso-e2 release deploy clean distclean vendor \
        vendor-clean check-sdk check-cc

check-sdk:
	@test -d "$(SDK)/include" || { \
		echo "No SDK artifacts found."; \
		echo "Either run 'make vendor OF_SDK=<path>' once to copy them into vendor/,"; \
		echo "or pass OF_SDK=<path to an openfpgaSDK checkout> on every build."; \
		exit 1; }

check-cc:
	@command -v $(CC) >/dev/null || { \
		echo "$(CC) not found — install a RISC-V toolchain or pass CROSS=<prefix>"; \
		echo "  macOS: brew install riscv-gnu-toolchain"; \
		exit 1; }

# ── Build ────────────────────────────────────────────────────────────
$(OBJ)/engine/%.o: $(SRC_DIR)/%.c | check-sdk check-cc
	@mkdir -p $(dir $@)
	@$(CC) $(CFLAGS) $(ENGINE_FLAGS) -c -o $@ $<

$(OBJ)/sdk/%.o: $(SDK)/%.c | check-sdk check-cc
	@mkdir -p $(dir $@)
	@$(CC) $(CFLAGS) -c -o $@ $<

# of_init.c's constructor is KEEP'd by app.ld, but the object still has to be
# on the link line for --gc-sections to find it.
$(ELF): $(OBJS)
	@mkdir -p $(dir $@)
	@$(CC) $(LDFLAGS) -o $@ $(CRT) $(OBJS) $(LIBS)
	@$(SIZE) $@

all elf: $(ELF)

# ── Game data ────────────────────────────────────────────────────────
E1_DATA ?= ../data/e1
E2_DATA ?= ../data/e2
E1_ISO  := $(CURDIR)/ecstatica.iso
E2_ISO  := $(CURDIR)/ecstatica2.iso

iso-e1:
	@test -d "$(E1_DATA)" || { echo "no E1 data at $(E1_DATA) — set E1_DATA="; exit 1; }
	@./mkiso.sh "$(E1_DATA)" "$(E1_ISO)" $(ISOFLAGS)

iso-e2:
	@test -d "$(E2_DATA)" || { echo "no E2 data at $(E2_DATA) — set E2_DATA="; exit 1; }
	@./mkiso.sh "$(E2_DATA)" "$(E2_ISO)" $(ISOFLAGS)

iso:
	@built=0; \
	if [ -d "$(E1_DATA)" ]; then $(MAKE) iso-e1 && built=1; fi; \
	if [ -d "$(E2_DATA)" ]; then $(MAKE) iso-e2 && built=1; fi; \
	if [ $$built -eq 0 ]; then \
		echo "no game data found at $(E1_DATA) or $(E2_DATA)"; exit 1; fi

# ── SD card image ────────────────────────────────────────────────────
# Assembles build/ in the layout the Pocket expects:
#
#   Cores/<author>.Ecstatica/     bitstream, loader, core JSON
#   Platforms/ecstatica.json      platform metadata
#   Assets/ecstatica/common/      os.bin, os.ini, ELF, soundfont, ISOs
#   Assets/ecstatica/<core id>/   one instance JSON per game
#
# ISOs are copied only if built — they are ~140-200 MB each, so `make release`
# stays useful for iterating on the ELF alone.
release: elf
	@test -f "$(RUNTIME)/os.bin" || { \
		echo "$(RUNTIME)/os.bin missing — this SDK checkout has no runtime/"; exit 1; }
	@rm -rf "$(OUT)/Cores" "$(OUT)/Platforms" "$(OUT)/Assets"
	@mkdir -p "$(OUT)/Cores/$(CORE_ID)" \
	          "$(OUT)/Platforms" \
	          "$(OUT)/Assets/$(PLATFORM)/common" \
	          "$(OUT)/Assets/$(PLATFORM)/$(CORE_ID)"

	@cp "$(RUNTIME)/bitstream.rbf_r" "$(RUNTIME)/loader.bin" "$(OUT)/Cores/$(CORE_ID)/"
	@for f in data video audio input interact variants; do \
		cp "core/$$f.json" "$(OUT)/Cores/$(CORE_ID)/"; done
	@sed -e 's/{{AUTHOR}}/$(AUTHOR)/g' \
	     -e 's/{{VERSION}}/$(VERSION)/g' \
	     -e 's/{{DATE}}/$(shell date +%Y-%m-%d)/g' \
	     core/core.json > "$(OUT)/Cores/$(CORE_ID)/core.json"

	@# 36x36 core icon. Every shipped openfpgaOS core carries one; generate
	@# ours if it is missing rather than leaving the only structural
	@# difference from a known-good core in place.
	@test -f core/icon.bin || python3 tools/mkicon.py core/icon.bin
	@cp core/icon.bin "$(OUT)/Cores/$(CORE_ID)/"

	@cp core/platform.json "$(OUT)/Platforms/$(PLATFORM).json"
	@# 521x165 platform banner, generated from tools/mkbanner.py. Replace
	@# core/platform_image.bin with real art whenever someone draws some.
	@mkdir -p "$(OUT)/Platforms/_images"
	@test -f "$(BANNER)" || python3 tools/mkbanner.py "$(BANNER)"
	@cp "$(BANNER)" "$(OUT)/Platforms/_images/$(PLATFORM).bin"

	@cp "$(RUNTIME)/os.bin" "$(OUT)/Assets/$(PLATFORM)/common/"
	@cp core/os.ini "$(OUT)/Assets/$(PLATFORM)/common/"
	@cp "$(ELF)" "$(OUT)/Assets/$(PLATFORM)/common/$(APP).elf"
	@if [ -n "$(BANK)" ]; then \
		cp "$(BANK)" "$(OUT)/Assets/$(PLATFORM)/common/bank.ofsf"; \
	else echo "  ! no MIDI bank found — music silent (SFX and speech unaffected)."; \
	     echo "    Drop one at core/bank.ofsf; see README 'Vendoring'."; fi

	@# One instance JSON per game; the Pocket browser lists these by filename.
	@if [ -f "$(E1_ISO)" ]; then \
		cp "$(E1_ISO)" "$(OUT)/Assets/$(PLATFORM)/common/"; \
		cp core/instance.e1.json "$(OUT)/Assets/$(PLATFORM)/$(CORE_ID)/Ecstatica.json"; \
	else echo "  ! $(notdir $(E1_ISO)) not built — run 'make iso-e1'"; fi
	@if [ -f "$(E2_ISO)" ]; then \
		cp "$(E2_ISO)" "$(OUT)/Assets/$(PLATFORM)/common/"; \
		cp core/instance.e2.json "$(OUT)/Assets/$(PLATFORM)/$(CORE_ID)/Ecstatica2.json"; \
	else echo "  ! $(notdir $(E2_ISO)) not built — run 'make iso-e2'"; fi

	@echo "Ready: $(OUT) ($$(du -sh '$(OUT)' | cut -f1))"

deploy: release
	@./deploy.sh "$(OUT)" "$(SDCARD)"

# ── Vendoring ────────────────────────────────────────────────────────
# Copy every redistributable SDK artifact into vendor/, after which neither
# building nor deploying needs an SDK checkout. Run once:
#
#   make vendor OF_SDK=/path/to/openfpgaSDK
#
# vendor/ is gitignored by default. Commit it if you want clones of this repo
# to build with no external checkout at all — it is ~7 MB.
#
# Licensing, which is why this is a copy and not a fetch: the SDK is
# Apache-2.0 and its bundled musl is MIT, both redistributable with the
# attribution reproduced into vendor/LICENSES and vendor/NOTICE.
#
# bank.ofsf is NOT copied. It is SC-55 sample data derived from Roland sound
# ROMs, marked LicenseRef-Proprietary-SampleData, and the SDK explicitly makes
# redistribution the downstream user's responsibility. Point BANK at your own,
# or drop one at core/bank.ofsf.
vendor:
	@test -d "$(OF_SDK)/src/sdk/include" || { \
		echo "need an openfpgaSDK checkout to vendor from: OF_SDK=<path>"; exit 1; }
	@rm -rf "$(VENDOR)"
	@mkdir -p "$(VENDOR)/sdk" "$(VENDOR)/runtime" "$(VENDOR)/LICENSES"
	@cp -R "$(OF_SDK)/src/sdk/include" "$(VENDOR)/sdk/"
	@cp -R "$(OF_SDK)/src/sdk/musl" "$(VENDOR)/sdk/"
	@cp "$(OF_SDK)/src/sdk/app.ld" "$(VENDOR)/sdk/"
	@cp "$(OF_SDK)/src/sdk/of_init.c" "$(OF_SDK)/src/sdk/of_midi.c" \
	    "$(OF_SDK)/src/sdk/of_smp_bank.c" "$(OF_SDK)/src/sdk/of_smp_voice.c" \
	    "$(OF_SDK)/src/sdk/of_smp_tables.c" "$(VENDOR)/sdk/"
	@cp "$(OF_SDK)/runtime/os.bin" "$(OF_SDK)/runtime/bitstream.rbf_r" \
	    "$(OF_SDK)/runtime/loader.bin" "$(VENDOR)/runtime/"
	@cp "$(OF_SDK)/LICENSES/Apache-2.0.txt" "$(OF_SDK)/LICENSES/MIT.txt" \
	    "$(VENDOR)/LICENSES/"
	@printf '%s\n' \
	  'Third-party artifacts vendored from the openfpgaOS SDK' \
	  'https://github.com/openfpgaOS/openfpgaSDK' \
	  '' \
	  'sdk/include, sdk/app.ld, sdk/of_*.c, runtime/*' \
	  '    (c) 2026 ThinkElastic <Think@Elastic.com> — Apache-2.0' \
	  '    See LICENSES/Apache-2.0.txt' \
	  '' \
	  'sdk/musl/' \
	  '    (c) the musl contributors — MIT' \
	  '    See LICENSES/MIT.txt' \
	  '' \
	  'Deliberately NOT vendored: bank.ofsf (the MIDI soundfont). It is' \
	  'SC-55 sample data derived from Roland sound ROMs and is not ours to' \
	  'redistribute. Supply your own at core/bank.ofsf, or build one with the' \
	  "SDK's tools/sf2_to_ofsf." \
	  > "$(VENDOR)/NOTICE"
	@echo "Vendored $$(du -sh '$(VENDOR)' | cut -f1) into vendor/ — OF_SDK no longer needed."
	@echo "Note: bank.ofsf excluded on licensing grounds; music is silent without one."

vendor-clean:
	@rm -rf "$(VENDOR)"

# ── Clean ────────────────────────────────────────────────────────────
clean:
	@rm -rf "$(OUT)"

distclean: clean
	@rm -f "$(E1_ISO)" "$(E2_ISO)"
